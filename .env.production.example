# Copy to .env.production and fill in real values (copy from existing .env /
# Render dashboard). Never commit this file.

# --- secrets (REQUIRED) ---
JWT_SECRET=<long random string, reuse your current one>
OPENROUTER_API_KEY=<your openrouter key>
YOUTUBE_API_KEY=<your youtube api key>
RESEND_API_KEY=<your resend key>

# --- managed services (keep your existing Neon / Upstash URLs) ---
DATABASE_URL=postgresql+asyncpg://<neon-user>:<pass>@<host>/<db>?sslmode=require
REDIS_URL=rediss://<upstash-user>:<pass>@<host>:6379

# --- app / CORS ---
# Public HTTPS URL of the API (sslip.io subdomain → your VPS IP).
API_DOMAIN=creatoros-api.45.59.120.101.sslip.io
# The Vercel frontend origin — must match EXACTLY (no trailing slash) and must
# be https. Only this origin is allowed by CORS.
FRONTEND_URL=https://<your-app>.vercel.app

# --- optional overrides ---
# ANALYZE_MODEL=deepseek/deepseek-v4-flash-0731
# EMBED_MODEL=openai/text-embedding-3-small
# MAX_COMMENTS=300